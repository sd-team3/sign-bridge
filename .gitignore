# ==========================================
# 1. Properties & Config Files (모든 설정 파일 무시)
# ==========================================
spring-server/src/main/resources/properties
*.env

# ==========================================
# 2. Java / Spring (Maven Build)
# ==========================================
spring-server/target/
*.class
*.jar
*.war

# ==========================================
# 3. Python / AI Data & Models
# ==========================================
python-server/__pycache__/
python-server/*.pyc
python-server/.pytest_cache/
python-server/venv/
python-server/env/
python-server/.venv/

# 학습 데이터 및 대용량 모델 파일
python-server/data/
python-server/model/*.h5
python-server/model/*.pth
python-server/model/*.onnx
python-server/model/*.pkl

# ==========================================
# 4. IDE / OS / System
# ==========================================
.idea/
.vscode/
*.swp
*.iml
.DS_Store
Thumbs.db

# ==========================================
# 5. Logs & Temp Files
# ==========================================
*.log
*.tmp