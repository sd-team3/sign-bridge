<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.soldesk.mapper.BoardMapper">
    <resultMap id="boardResultMap" type="com.soldesk.vo.BoardVO">
        <id column="board_id" property="boardId" />
        <result column="member_id" property="memberId" />
        <result column="board_title" property="boardTitle" />
        <result column="board_content" property="boardContent" />
        <result column="category_idx" property="categoryIdx" />
        <result column="view_count" property="viewCount" />
        <result column="notice_yn" property="noticeYn" />
        <result column="reg_date" property="regDate" />
        <result column="mod_date" property="modDate" />
        <result column="member_name" property="memberName" />
    </resultMap>

    <select id="findByCategory" resultMap="boardResultMap">
        select 
            b.board_id, 
            b.board_title, 
            b.board_content, 
            b.category_idx, 
            b.view_count,
            b.notice_yn,
            b.reg_date, 
            b.member_id,
            m.member_name,
            m.role
        from board b
        join member m
        on b.member_id = m.member_id
        <where>
            <if test="category != null and category != ''">
                and category_idx = #{category}
            </if>
        </where> 
        order by b.reg_date desc
        limit #{start}, #{count}
    </select>
    <select id="countByCategoryBoard" parameterType="string" resultType="int">
        select count(*)
        from board
        <where>
            <if test="category != null and category != ''">
                and category_idx = #{category}
            </if>
        </where> 
    </select>
</mapper>