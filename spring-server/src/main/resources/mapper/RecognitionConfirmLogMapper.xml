<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.soldesk.mapper.RecognitionConfirmLogMapper">

    <resultMap id="recognitionConfirmLogResultMap" type="com.soldesk.vo.RecognitionConfirmLogVO">
        <id     property="recognitionConfirmLogId" column="recognition_confirm_log_id" />
        <result property="clientSessionId"          column="client_session_id" />
        <result property="memberId"                    column="member_id" />
        <result property="confirmedChar"                  column="confirmed_char" />
        <result property="confidence"                        column="confidence" />
        <result property="holdDurationMs"                       column="hold_duration_ms" />
        <result property="landmarkJson"                            column="landmark_json" />
        <result property="regDate"                                  column="reg_date" />
    </resultMap>

    <insert id="insertConfirmLog" parameterType="com.soldesk.vo.RecognitionConfirmLogVO"
            useGeneratedKeys="true" keyProperty="recognitionConfirmLogId">
        INSERT INTO recognition_confirm_log (
            client_session_id,
            member_id,
            confirmed_char,
            confidence,
            hold_duration_ms,
            landmark_json
        ) VALUES (
            #{clientSessionId},
            #{memberId},
            #{confirmedChar},
            #{confidence},
            #{holdDurationMs},
            #{landmarkJson}
        )
    </insert>

    <select id="findByClientSessionId" resultMap="recognitionConfirmLogResultMap">
        SELECT *
        FROM recognition_confirm_log
        WHERE client_session_id = #{clientSessionId}
        ORDER BY reg_date ASC
    </select>

    <select id="findByMemberId" resultMap="recognitionConfirmLogResultMap">
        SELECT *
        FROM recognition_confirm_log
        WHERE member_id = #{memberId}
        ORDER BY reg_date ASC
    </select>

</mapper>
